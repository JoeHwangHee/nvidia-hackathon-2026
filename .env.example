# 복사해서 .env 로 저장. .env 는 git 에 올리지 않는다.
# 공공데이터포털 마이페이지 > 오픈API > 활용신청 현황 에서 "일반 인증키(Decoding)" 값을 넣는다.
# (ingest.py 가 urlencode 하므로 Encoding 키를 넣으면 이중 인코딩으로 실패한다)
DATA_GO_KR_SERVICE_KEY=

# NVIDIA NIM (G4 확인용; 9/23~24)
NVIDIA_API_KEY=
NIM_MODEL=nvidia/nemotron-3-super-120b-a12b

# trade-baci 기반 Neo4j (선택; 런타임 의존은 두지 않는다)
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j
DATA_DIR=.data/
BACI_URL=https://www.cepii.fr/DATA_DOWNLOAD/baci/data/BACI_HS22_V202601.zip
