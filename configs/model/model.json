{
  "config_version": "model-0.8",
  "model": "nvidia/nemotron-3-super-120b-a12b",
  "endpoint": "https://integrate.api.nvidia.com/v1/chat/completions",
  "api_key_env": "NVIDIA_API_KEY",
  "request": {
    "temperature": 1.0,
    "top_p": 0.95,
    "max_tokens": 4096,
    "enable_thinking": false,
    "structured_output": "json_object"
  },
  "retry": {
    "max_5xx_retries": 3,
    "backoff_base_ms": 1000,
    "backoff_factor": 2
  },
  "timeouts": {
    "request_cap_ms": 60000,
    "end_reserve_ms": 5000
  },
  "limits": {
    "model_requests": 10,
    "tokens": 32000,
    "wall_ms": 300000,
    "tool_attempts": 8,
    "basic_tool_attempts": 5,
    "investigator_comparisons": 2,
    "revision_stages": 1,
    "revision_requeries": 2,
    "final_verify": 1
  },
  "prompts": {
    "investigator": "investigator.txt",
    "claims_template": "claims_template.txt",
    "claims_freeform": "claims_freeform.txt",
    "critic": "critic.txt"
  }
}
